# --- LLM (OpenAI-совместимый API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1

# --- Web Search (brave, yandex) ---
SEARCH_PROVIDER=brave

# Yandex Search API (https://yandex.cloud/services/search-api)
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Brave Search API (https://brave.com/search/api) — используется при SEARCH_PROVIDER=brave
BRAVE_API_KEY=

SEARCH_RESULTS_COUNT=7

# --- Агент и HTTP ---
MAX_AGENT_STEPS=24
MAX_VALIDATION_RETRIES=2
FETCH_PAGE_MAX_CHARS=8000
MAX_TRANSCRIPT_CHARS=12000
HTTP_TIMEOUT=15

# --- Логирование ---
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
